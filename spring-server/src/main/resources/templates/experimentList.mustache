<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>실험 목록</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-dark bg-dark px-3">
    <span class="navbar-brand">ML 실험 기록장</span>
    <a class="btn btn-outline-light btn-sm" href="/experiments/new">새 실험 추가</a>
</nav>

<div class="container mt-4">
    <h2 class="mb-3">실험 목록</h2>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>알고리즘</th>
            <th>옵티마이저</th>
            <th>Epochs</th>
            <th>Batch</th>
            <th>LR</th>
            <th>Accuracy</th>
            <th>Loss</th>
            <th>태그</th>
            <th>메모</th>
            <th>생성일</th>
            <th>삭제</th>
        </tr>
        </thead>
        <tbody>
        {{#experiments}}
        <tr>
            <td>{{id}}</td>
            <td>{{algorithm}}</td>
            <td>{{optimizer}}</td>
            <td>{{epochs}}</td>
            <td>{{batchSize}}</td>
            <td>{{learningRate}}</td>
            <td>{{accuracy}}</td>
            <td>{{loss}}</td>
            <td>{{tag}}</td>
            <td>{{memo}}</td>
            <td>{{createdAt}}</td>
            <td>
                <form action="/experiments/{{id}}/delete" method="post" style="margin:0">
                    <button type="submit" class="btn btn-danger btn-sm"
                            onclick="return confirm('정말 삭제하시겠습니까?')">삭제</button>
                </form>
            </td>
        </tr>
        {{/experiments}}
        {{^experiments}}
        <tr>
            <td colspan="12" class="text-center text-muted">등록된 실험이 없습니다.</td>
        </tr>
        {{/experiments}}
        </tbody>
    </table>
</div>
</body>
</html>
